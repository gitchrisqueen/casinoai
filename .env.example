# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
# Optional — deferred until production; Anthropic tokens are the most expensive
ANTHROPIC_API_KEY=
# Optional — only for loading strategy PDFs from Google Drive folders
GOOGLE_API_KEY=
# Local Ollama server — no key needed
OLLAMA_BASE_URL=http://localhost:11434
# Ollama Cloud (flat-rate subscription models) — key from ollama.com/settings/keys
OLLAMA_API_KEY=
OLLAMA_CLOUD_BASE_URL=https://ollama.com/v1
# Default model id (e.g. openai/gpt-5.2, ollama/llama3.1:8b, ollama-cloud/kimi-k2:1t-cloud)
CASINOAI_DEFAULT_MODEL=ollama/llama3.1:8b
